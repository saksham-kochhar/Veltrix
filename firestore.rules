rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Chat history (Android app). Parent user rule does NOT cover subcollections.
      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Backend-only collections (Admin SDK bypasses rules).
    match /wallets/{document=**} {
      allow read, write: if false;
    }
    match /reservations/{document=**} {
      allow read, write: if false;
    }
    match /usage_logs/{document=**} {
      allow read, write: if false;
    }
    match /model_costs/{document=**} {
      allow read, write: if false;
    }
  }
}
