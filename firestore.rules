rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Security data: FastAPI backend only (Firebase Admin SDK). No client SDK access.
      match /sessions/{sessionId} {
        allow read, write: if false;
      }

      match /login_events/{eventId} {
        allow read, write: if false;
      }

      match /security_events/{eventId} {
        allow read, write: if false;
      }

      match /security_prefs/{docId} {
        allow read, write: if false;
      }

      match /notification_prefs/{docId} {
        allow read, write: if false;
      }

      match /push_tokens/{tokenId} {
        allow read, write: if false;
      }

      match /notification_log/{docId} {
        allow read, write: if false;
      }
    }

    match /wallets/{document=**} {
      allow read, write: if false;
    }
    match /reservations/{document=**} {
      allow read, write: if false;
    }
    match /usage_logs/{document=**} {
      allow read, write: if false;
    }
    match /model_costs/{document=**} {
      allow read, write: if false;
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
